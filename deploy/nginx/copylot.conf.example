map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name copylot.example.org www.copylot.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name copylot.example.org www.copylot.example.org;
    server_tokens off;
    client_max_body_size 512m;

    # Replace with your cert paths (for example from certbot).
    ssl_certificate /etc/letsencrypt/live/copylot.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/copylot.example.org/privkey.pem;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Replace any client-supplied chain. The application rate limiter uses the
    # direct proxy peer and must not accept a spoofable first-hop address.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Analysis app (non-AI).
    location / {
        proxy_pass http://127.0.0.1:8081;
    }

    # Home Server AI routes are canceled to save NAS resources.
    location = /tool-ai {
        return 404;
    }

    location /tool-ai/ {
        return 404;
    }

    location = /ai {
        return 404;
    }

    location /ai/ {
        return 404;
    }

    # Project viewer portal (password -> project).
    location /viewer/ {
        rewrite ^/viewer/?(.*)$ /$1 break;
        proxy_cookie_path /api/tabs/ /viewer/api/tabs/;
        proxy_pass http://127.0.0.1:18081;
    }

    location = /viewer {
        return 308 /viewer/;
    }

    # Project viewer portal with AI is canceled on the Home Server.
    location = /viewer-ai {
        return 404;
    }

    location /viewer-ai/ {
        return 404;
    }
}
