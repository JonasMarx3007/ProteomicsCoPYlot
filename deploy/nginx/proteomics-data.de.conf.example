map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name proteomics-data.de www.proteomics-data.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name proteomics-data.de www.proteomics-data.de;

    # Replace with your cert paths (for example from certbot).
    ssl_certificate /etc/letsencrypt/live/proteomics-data.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proteomics-data.de/privkey.pem;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Analysis app (non-AI).
    location / {
        proxy_pass http://127.0.0.1:8081;
    }

    # Analysis AI app (optional existing setup).
    location /ai/ {
        rewrite ^/ai/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:8082;
    }

    # Project viewer portal (password -> project).
    location /viewer/ {
        rewrite ^/viewer/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:18081;
    }

    # Project viewer portal with AI.
    location /viewer-ai/ {
        rewrite ^/viewer-ai/?(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:18082;
    }
}
